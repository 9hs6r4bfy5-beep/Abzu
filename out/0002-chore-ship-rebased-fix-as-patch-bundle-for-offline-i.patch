++WHITESUR_GTK_TAG="2026-09-10"
++WHITESUR_ICON_TAG="2025-07-29"
++WHITESUR_CURSOR_URL="https://github.com/vinceliuice/WhiteSur-cursors/archive/refs/heads/master.tar.gz"
+ 
+ mkdir -p "${THEME_DIR}" "${ICON_DIR}" "${GNOME_EXT_DIR}"
