# build/derivations/iso.nix
# Hybrid El Torito bootable ISO for Intel Macs (x86_64).
#
# Boot story (mirrors scripts/make-iso.sh in the Makefile pipeline):
#   * The ESP is a real FAT image (esp.img) built INSIDE this derivation with
#     mtools + mkfs.vfat — El Torito's -b/-e options want an image FILE, not a
#     directory tree.
#   * A single `xorriso -as mkisofs` invocation produces the hybrid ISO:
#         stage tree  →  ISO9660/RockRidge/Joliet data area (label ABZU_ROOTFS)
#         esp.img     →  El Torito EFI boot entry
#                        (-no-emul-boot -boot-load-size 4)
#         -isohybrid-gpt-basdat  →  protective GPT so `dd` to USB boots too
#   * Volume label is unified to ABZU_ROOTFS everywhere (refind.conf matches
#     on it), so rEFInd's menu entry resolves.
{ lib, stdenvNoCC, rootfs, refind, xorriso, mtools, dosfstools,
  volumeLabel ? "ABZU_ROOTFS" }:

stdenvNoCC.mkDerivation rec {
  pname = "abzu-iso-intel";
  version = "0.1.0";

  nativeBuildInputs = [ xorriso mtools dosfstools ];

  # Deterministic timestamps for everything baked into the image.
  export SOURCE_DATE_EPOCH = "315532800"; # 1980-01-01, ISO-9660 epoch floor

  buildCommand = ''
    runHook preBuild

    mkdir -p $out/stage $out/esp-tree

    # 1. Stage the Darwin root filesystem (the ISO's primary data area; XNU
    #    mounts it via the RockRidge bridge or the installer unpacks it).
    echo "==> Staging rootfs..."
    cp -r --no-preserve=ownership ${rootfs}/. $out/stage/

    # 2. Stage rEFInd into an ESP-shaped tree (BOOTX64.EFI + BOOTIA32.EFI for
    #    MBP 4,1 + refind.conf generated by derivations/refind.nix).
    echo "==> Staging rEFInd..."
    mkdir -p $out/esp-tree/EFI/BOOT $out/esp-tree/EFI/refind
    cp -r --no-preserve=ownership ${refind}/EFI/BOOT/.  $out/esp-tree/EFI/BOOT/
    cp -r --no-preserve=ownership ${refind}/EFI/refind/. $out/esp-tree/EFI/refind/

    # 3. Build the ESP as a real FAT image inside the derivation.
    #    (mkisofs-style El Torito requires a FILE here, not a directory.)
    echo "==> Building ESP image (esp.img)..."
    dd if=/dev/zero of=esp.img bs=1M count=8 status=none
    mkfs.vfat -F 12 -n "ABZU_EFI" esp.img >/dev/null
    mmd  -i esp.img ::/EFI ::/EFI/BOOT ::/EFI/refind
    mcopy -s -i esp.img $out/esp-tree/EFI/BOOT/.  ::/EFI/BOOT/
    mcopy -s -i esp.img $out/esp-tree/EFI/refind/. ::/EFI/refind/

    # 4. Single-pass hybrid ISO: one xorriso run, esp.img as the El Torito
    #    boot image, GPT BASDAT marker so the same file works burned OR
    #    dd'd to USB. No second "-append_partition" hack and no split
    #    two-stage build — that was the old bug that produced images with a
    #    duplicated, non-bootable partition table.
    echo "==> Building hybrid El Torito ISO..."
    xorriso -as mkisofs \
      -r -joliet-long \
      -V "${volumeLabel}" \
      -c boot.catalog \
      -b esp.img \
      -no-emul-boot \
      -boot-load-size 4 \
      -boot-info-table \
      -eltorito-alt-boot \
      -e esp.img \
      -no-emul-boot \
      -isohybrid-gpt-basdat \
      -o $out/abzu-intel-installer.iso \
      $out/stage

    ls -l $out/abzu-intel-installer.iso
    echo "==> ISO successfully created at: $out/abzu-intel-installer.iso"

    runHook postBuild
  '';

  meta = with lib; {
    description = "Bootable hybrid ISO for Abzu Darwin (Intel x86_64); buildable on Linux and Darwin hosts";
    homepage = "https://github.com/9hs6r4bfy5-beep/abzu-iso";
    license = licenses.unfreeRedistributable; # contains Apple APSL-2.0 kernel payload
    # The ISO builder itself is host-agnostic (it copies trees and runs
    # xorriso); only the *contents* are x86_64-darwin payloads.
    platforms = platforms.linux ++ platforms.darwin;
  };
}
