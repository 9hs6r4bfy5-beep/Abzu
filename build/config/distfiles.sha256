# config/distfiles.sha256 — sha256 lock file for build/scripts/fetch-distfiles.sh
# Format: <hex-sha256>  <filename-in-build/distfiles>   (verified via `sha256sum -c`)
# Regenerate entries with:  sha256sum build/distfiles/<file>
