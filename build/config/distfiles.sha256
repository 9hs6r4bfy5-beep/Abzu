e7546f1c978a7c75b676953a360194a61e921cb45a4804497b4f346a460545cd  gnustep-base-1.31.1.tar.gz
0c03a1b6313babd592ec58fcb825091f77eb27429a4ce4306ec3a7cfa7f9a1f6  gnustep-gui-0.32.0.tar.gz
ce171095012ac5d845f6e1285a5c71e011fd00aa5981ea1d5a5183706478218d  gnustep-back-0.32.0.tar.gz
533a1ca5d6595793725bca7641d9461a0f00dd1732dded3e4281196f5dd21736  gworkspace-1.1.0.tar.gz
# rEFInd prebuilt EFI binaries (SourceForge mirrors rotate; verify before committing)
