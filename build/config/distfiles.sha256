# config/distfiles.sha256 — sha256 lock file for build/scripts/fetch-distfiles.sh
# Format: <hex-sha256>  <filename-in-build/distfiles>   (verified via `sha256sum -c`)
# Regenerate entries with:  sha256sum build/distfiles/<file>
#
# GNUstep core + GWorkspace (ftp.gnustep.org). NOTE: gnustep-base/gui/back/apps
# live in per-category directories on the FTP mirror; fetch-distfiles.sh must
# use those paths (the flat /pub/gnustep/core/ URLs 404 for everything but
# gnustep-make).
