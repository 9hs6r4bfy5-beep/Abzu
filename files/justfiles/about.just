# Show information about Abzu
[group('Abzu')]
about:
    @echo "Abzu"
    @echo "An elegant, powerful operating system for desktops, workstations"
    @echo "and homelabs that honours and preserves the ancient traditions."
    @echo ""
    @echo "Repository: https://github.com/9hs6r4bfy5-beep/Abzu"
    @echo "Base image: Universal Blue (uBlue) on Fedora Atomic"
    @echo "Kernel: $(uname -r)"
    @echo "Uptime: $(uptime -p)"
