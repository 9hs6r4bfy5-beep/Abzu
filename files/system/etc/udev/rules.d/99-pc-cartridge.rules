# Trigger the cartridge launcher when a PC Cartridge SSD is inserted.
# Matches any USB storage device whose filesystem is labelled PC-CART.
# This works with any SATA dock, since the label is the identifier.

ACTION=="add", \
  SUBSYSTEM=="block", \
  SUBSYSTEMS=="usb", \
  ENV{ID_FS_LABEL}=="PC-CART", \
  TAG+="systemd", \
  ENV{SYSTEMD_WANTS}="cartridge-launch@%k.service"
