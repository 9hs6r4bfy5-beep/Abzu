# abzu.script - Plymouth theme for Abzu

# --- Background: deep abyssal gradient ---
Window.SetBackgroundTopColor(0.02, 0.02, 0.04);
Window.SetBackgroundBottomColor(0.04, 0.12, 0.18);

# --- Central logo ---
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(0.95);

# --- Optional: subtle pulsing effect on the logo ---
global.pulse_frame = 0;
fun refresh_callback()
{
    global.pulse_frame++;
    # Oscillate opacity between 0.85 and 0.95
    op = 0.90 + Math.Sin(global.pulse_frame / 60) * 0.05;
    logo.sprite.SetOpacity(op);
}
Plymouth.SetRefreshFunction(refresh_callback);
