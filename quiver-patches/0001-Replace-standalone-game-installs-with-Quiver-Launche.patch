-Terminal=true
-Categories=Game;
-OnlyShowIn=GNOME;
-EOF
-
-chmod +x /etc/skel/Desktop/Install-SA-Mod-Manager.desktop
-
-echo "--- SA Mod Manager installer staged ---"
-echo "Run the 'Install Sonic Adventure Mod Manager' desktop launcher after first login."
