userland/doas/openbsd-doas-src/y.tab.c
userland/doas/openbsd-doas-src/y.tab.h
userland/doas/openbsd-doas-src/parse.tab.c
userland/doas/openbsd-doas-src/parse.tab.h

# Build artifacts
*.log
*.tmp
userland/out/
userland/stage/
userland/distfiles/
EOF
