<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//GNUstep//DTD plist 0.9//EN" "http://www.gnustep.org/plist-0_9.xml">
<plist version="0.9">
<dict>
    <key>NSGlobalDomain</key>
    <dict>
        <!-- Force the classic Mac OS X "Aqua" interface style -->
        <key>NSInterfaceStyle</key>
        <string>macintosh</string>
        
        <!-- Use the classic Aqua font stack -->
        <key>NSFont</key>
        <dict>
            <key>NSFontName</key>
            <string>Lucida Grande</string>
            <key>NSFontSize</key>
            <string>12</string>
        </dict>
        
        <!-- "Water and Light" Color Palette -->
        <!-- Translucent Aqua Blue for Highlights -->
        <key>NSHighlightColor</key>
        <string>0.25 0.65 0.95 1.0</string>
        
        <!-- Soft, light blue/white for Window Backgrounds -->
        <key>NSWindowBackgroundColor</key>
        <string>0.92 0.95 0.98 1.0</string>
        
        <!-- Dark Navy/Charcoal for crisp, readable text -->
        <key>NSTextColor</key>
        <string>0.1 0.1 0.15 1.0</string>
        
        <!-- Use the ART backend for smooth, anti-aliased "Aqua" rendering -->
        <key>GSBackend</key>
        <string>art</string>
    </dict>
</dict>
</plist>
